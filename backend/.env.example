# DeepSeek API Key（必填，用于AI投资建议）
# 去 https://platform.deepseek.com 注册，送500万token免费额度
# 用完之后才收费，约 ￥1/百万字
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek模型（可选）
# deepseek-chat = V3（日常对话，速度快）
# deepseek-reasoner = R1（深度推理，更聪明但慢）
DEEPSEEK_MODEL=deepseek-chat

# 博主"门前有棵树"的公开页面URL（可选，用于爬虫尝试）
# BLOGGER_URL=https://example.com/blogger-page
